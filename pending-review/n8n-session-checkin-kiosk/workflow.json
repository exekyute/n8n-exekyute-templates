      "id": "3e408222-2ccb-46b1-b6ad-d1ce72791283",
      "name": "Fetch Attendance History",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1024,
        496
      ],
      "executeOnce": true,
      "alwaysOutputData": true
