    {
      "parameters": {
        "jsCode": "const cfg = $('Workflow Configuration').first().json;\nconst roster = $('Look Up Registration').first().json;\nconst scheduleRows = $('Read Cohort Schedule').all().map(i => i.json).filter(r => r.session_code);\nconst historyRows = $input.all().map(i => i.json).filter(r => r.session_code);\nconst isRegistered = Boolean(roster.email);\nconst threshold = Number(cfg.certification_threshold) > 0 ? Number(cfg.certification_threshold) : 0.8;\nconst todayIso = $today.toFormat('yyyy-MM-dd');\nconst isRequired = (r) => {\n  const v = String(r.required === undefined || r.required === '' ? 'TRUE' : r.required).trim().toLowerCase();\n  return v === 'true' || v === 'yes' || v === '1';\n};\nconst requiredRows = scheduleRows.filter(isRequired);\nconst requiredCodes = new Set(requiredRows.map(r => String(r.session_code).trim()));\nconst attendedCodes = new Set(historyRows.map(r => String(r.session_code).trim()).filter(c => requiredCodes.has(c)));\nconst attended = attendedCodes.size;\nconst requiredTotal = requiredRows.length;\nconst remaining = requiredRows.filter(r => String(r.session_date).trim() > todayIso && !attendedCodes.has(String(r.session_code).trim())).length;\nconst currentFraction = requiredTotal > 0 ? attended / requiredTotal : 0;\nconst bestCaseFraction = requiredTotal > 0 ? Math.min(1, (attended + remaining) / requiredTotal) : 0;\nconst neededSessions = Math.ceil(threshold * requiredTotal - 0.000000001);\nconst shortfallSessions = Math.max(0, neededSessions - (attended + remaining));\nconst unreachable = isRegistered && requiredTotal > 0 && bestCaseFraction < threshold - 0.000000001;\nconst pct = (f) => Math.round(f * 1000) / 10;\nconst participantName = String(roster.name || cfg.normalized_email);\nlet kioskMessage;\nif (!isRegistered) {\n  kioskMessage = 'You were not on the pre-registered roster, so this visit was logged as a walk-in for session ' + cfg.session_code + '. Please see the program coordinator to get added to a cohort.';\n} else if (requiredTotal === 0) {\n  kioskMessage = 'Check-in recorded for session ' + cfg.session_code + '. No required sessions were found for cohort ' + String(roster.cohort) + ', so no eligibility math was run.';\n} else {\n  kioskMessage = 'Check-in recorded for session ' + cfg.session_code + '. Attendance so far: ' + attended + ' of ' + requiredTotal + ' required sessions (' + pct(currentFraction) + '%). Required sessions still ahead: ' + remaining + '.';\n}\nreturn [{ json: {\n  status: isRegistered ? 'REGISTERED' : 'WALK_IN',\n  participant_name: participantName,\n  email: String(cfg.normalized_email),\n  cohort: String(roster.cohort || 'UNREGISTERED'),\n  session_code: String(cfg.session_code),\n  attended: attended,\n  required_total: requiredTotal,\n  remaining_required: remaining,\n  current_pct: pct(currentFraction),\n  best_case_pct: pct(bestCaseFraction),\n  threshold_pct: pct(threshold),\n  shortfall_sessions: shortfallSessions,\n  unreachable: unreachable,\n  kiosk_message: kioskMessage\n} }];"
      },
